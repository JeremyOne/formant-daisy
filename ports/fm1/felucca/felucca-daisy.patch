@@ -35,11 +35,22 @@
 #if FELUCCA_ADPCM && !FELUCCA_SLICE
 #error "FELUCCA_ADPCM needs FELUCCA_SLICE (ADPCM is engine 14, after SLICE)"
 #endif
+#ifndef FELUCCA_DAISY
+#define FELUCCA_DAISY 1          /* DAISY (eng_daisy.c, Formant Daisy's singer), engine 15; 14 is ADPCM or reserved */
+#endif
+#if FELUCCA_DAISY && !FELUCCA_SLICE
+#error "FELUCCA_DAISY needs FELUCCA_SLICE (DAISY is engine 15, after SLICE and ADPCM's 14)"
+#endif
+#if FELUCCA_DAISY
+#define NENGINES 16              /* ... SLICE (13), ADPCM or reserved (14), DAISY (15) */
+#define ENGI_DAISY 15u
+#else
 #define NENGINES (13 + FELUCCA_SLICE + FELUCCA_ADPCM)   /* SLICE (13), then ADPCM (14): the other engines keep their
                                                          * numbers */
+#endif
 #define ENGI_ADPCM 14u
 #define ENGI_DIGITAL 1u          /* reserved without FELUCCA_FM4: never selectable (eng_ok), its sounds load as FM6 */
-#define NENG_SHOWN (NENGINES - !FELUCCA_FM4)   /* the engines one can pick: PRESETS, the EDIT layer, the editor,
+#define NENG_SHOWN (NENGINES - !FELUCCA_FM4 - (FELUCCA_DAISY && !FELUCCA_ADPCM))   /* the engines one can pick: PRESETS, the EDIT layer, the editor,
                                                 * in the display order of engines.c ENGINE_ORDER */
 #define UP_SLOTS 32u             /* user presets (upreset.c) */
 
